{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/apps-desktop.tsbuildinfo",
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "../../next-env.d.ts",
    "../../src/app/**/*",
    "../../src/config/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "../../src/**/__tests__/**",
    "../../src/**/*.test.ts",
    "../../src/**/*.test.tsx",
    "../../src/**/*.spec.ts",
    "../../src/**/*.spec.tsx"
  ]
}
