[Unit]
Description=Timeline Studio Telegram bot runtime cleanup

[Service]
Type=oneshot
User=timeline-bot
Group=timeline-bot
WorkingDirectory=/opt/timeline-studio
Environment=NODE_ENV=production
EnvironmentFile=/etc/timeline-studio/bot-worker.env
ExecStart=/usr/bin/env bun run apps/cli/src/index.ts bot-cleanup --delete
StateDirectory=timeline-studio
CacheDirectory=timeline-studio
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/timeline-studio /var/cache/timeline-studio /opt/timeline-studio/test-results
