{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "lib": ["ES2021", "WebWorker"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../src/*"],
      "@domains/*": ["../packages/domains/src/*"],
      "@core/*": ["../packages/core/src/*"],
      "@adapters/*": ["../src/adapters/*"],
      "@node/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "../src/adapters/node/**/*", "../packages/core/src/ports/**/*", "../src/types/generated/**/*"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
