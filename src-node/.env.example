# Server Configuration
PORT=3001
HOST=localhost

# FFmpeg Paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Cache Configuration
CACHE_DIR=~/.cache/timeline-studio
CACHE_SIZE=1000
CACHE_TTL=1800000

# Processing
MAX_CONCURRENT_WORKERS=4
THUMBNAIL_QUALITY=85

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Note: Redis is NOT required - we use SQLite for caching and queue
