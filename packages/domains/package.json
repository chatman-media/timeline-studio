{
  "name": "@timeline-studio/domains",
  "version": "3.61.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ai-director": {
      "types": "./src/ai-director/index.ts",
      "default": "./src/ai-director/index.ts"
    },
    "./ai-director/*": {
      "types": "./src/ai-director/*",
      "default": "./src/ai-director/*"
    },
    "./ai-services": {
      "types": "./src/ai-services/index.ts",
      "default": "./src/ai-services/index.ts"
    },
    "./ai-services/*": {
      "types": "./src/ai-services/*",
      "default": "./src/ai-services/*"
    },
    "./ai-tools": {
      "types": "./src/ai-tools/index.ts",
      "default": "./src/ai-tools/index.ts"
    },
    "./ai-tools/*": {
      "types": "./src/ai-tools/*",
      "default": "./src/ai-tools/*"
    },
    "./browser": {
      "types": "./src/browser/index.ts",
      "default": "./src/browser/index.ts"
    },
    "./browser/*": {
      "types": "./src/browser/*",
      "default": "./src/browser/*"
    },
    "./media-management": {
      "types": "./src/media-management/index.ts",
      "default": "./src/media-management/index.ts"
    },
    "./media-management/*": {
      "types": "./src/media-management/*",
      "default": "./src/media-management/*"
    },
    "./project-management": {
      "types": "./src/project-management/index.ts",
      "default": "./src/project-management/index.ts"
    },
    "./project-management/*": {
      "types": "./src/project-management/*",
      "default": "./src/project-management/*"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    },
    "./shared/styles/*": {
      "default": "./src/shared/styles/*"
    },
    "./shared/*": {
      "types": "./src/shared/*",
      "default": "./src/shared/*"
    },
    "./subtitles": {
      "types": "./src/subtitles/index.ts",
      "default": "./src/subtitles/index.ts"
    },
    "./subtitles/*": {
      "types": "./src/subtitles/*",
      "default": "./src/subtitles/*"
    },
    "./system-integration": {
      "types": "./src/system-integration/index.ts",
      "default": "./src/system-integration/index.ts"
    },
    "./system-integration/*": {
      "types": "./src/system-integration/*",
      "default": "./src/system-integration/*"
    },
    "./test/setup": {
      "types": "./src/test/setup.ts",
      "default": "./src/test/setup.ts"
    },
    "./video-editing": {
      "types": "./src/video-editing/index.ts",
      "default": "./src/video-editing/index.ts"
    },
    "./video-editing/*": {
      "types": "./src/video-editing/*",
      "default": "./src/video-editing/*"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check:type": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@timeline-studio/core": "3.61.1"
  }
}
