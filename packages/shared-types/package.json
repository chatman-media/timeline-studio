{
  "name": "@timeline/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Timeline Studio — ProjectSchema, state types, commands. Generated from Rust via specta/schemars.",
  "license": "MIT",
  "author": "Alexander Kireyev <ak.chatman.media@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chatman-media/timeline-studio"
  },
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts"
    },
    "./state": {
      "types": "./src/state.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
