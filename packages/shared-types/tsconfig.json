{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": "../../",
    "paths": {
      "@tauri-apps/api/core": ["./src/tauri-shim.d.ts"],
      "@tauri-apps/api/event": ["./src/tauri-shim.d.ts"],
      "@tauri-apps/api/webviewWindow": ["./src/tauri-shim.d.ts"]
    }
  },
  "include": ["src/**/*", "../../src/types/**/*"],
  "exclude": ["dist", "node_modules"]
}
